LEGAL_AGENT_DATA=/data/legal-agent
LEGAL_AGENT_HOST=127.0.0.1
LEGAL_AGENT_PORT=8091
# OpenAI-compatible new-api (host port 3002 -> container 3000)
AI_BASE=http://127.0.0.1:3002/v1
# Optional: leave empty to read token name=claude from NEWAPI_DB (same as zentao-audit)
AI_KEY=
AI_MODEL=grok-4.5
NEWAPI_DB=/data/new-api/data/one-api.db
NEWAPI_TOKEN_NAME=claude
# Dev auth (change in production)
DEV_TOKEN=dev-local-token
